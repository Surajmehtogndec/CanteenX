@model CanteenX.Models.CanteenOwner.CanteenAccountDetailsDto
@{
    ViewData["Title"] = "Config Account";
    Layout = "_CanteenOwnerLayout";
}

<!-- Custom CSS for iOS Premium Look -->
<style>
    .ios-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.03);
    }
    
    .ios-header {
        background: linear-gradient(135deg, #1e2025 0%, #2d3036 100%);
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        padding: 24px;
    }
    
    .ios-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #007aff; /* Apple iOS Blue */
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
    }

    .ios-input-group {
        background: #f5f5f7; /* iOS background gray */
        border-radius: 12px;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }
    
    .ios-input-group:focus-within {
        background: #ffffff;
        border-color: #007aff;
        box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.1);
    }

    .ios-input-group .input-group-text {
        background: transparent;
        border: none;
        color: #86868b;
        padding-left: 16px;
    }

    .ios-input-group .form-control {
        background: transparent;
        border: none;
        padding: 14px 16px 14px 8px;
        color: #1d1d1f;
        font-weight: 500;
    }
    
    .ios-input-group .form-control:focus {
        box-shadow: none;
    }

    .ios-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #86868b;
        margin-bottom: 6px;
        display: block;
    }

    .ios-btn-primary {
        background-color: #007aff; /* Match Sidebar Active Color */
        color: white;
        border-radius: 14px;
        padding: 14px;
        font-weight: 600;
        border: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(0, 122, 255, 0.25);
    }
    
    .ios-btn-primary:hover {
        background-color: #0066d6;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 122, 255, 0.35);
    }

    .ios-alert {
        background: #fdf5e6;
        border: 1px solid #fbe3b6;
        border-radius: 12px;
        color: #b07d13;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="ios-card overflow-hidden">
                
                <!-- Premium iOS Header -->
                <div class="ios-header d-flex align-items-center gap-3">
                    <div class="ios-icon-box">
                        <i class="bi bi-bank2 fs-4 text-white"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold text-white" style="letter-spacing: 0.5px;">Settlement Bank Account</h5>
                        <div class="text-white-50" style="font-size: 0.85rem;">Link your bank account securely to receive daily payouts.</div>
                    </div>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4 p-md-5">
                    <form id="bankAccountForm" asp-controller="CanteenOwner" asp-action="LinkBankAccount" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="ios-label">Account Holder Name (As per Bank)</label>
                            <div class="input-group ios-input-group">
                                <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                                <input asp-for="AccountHolderName" class="form-control" placeholder="Account Holder Name" autocomplete="AccountHolderName" />
                                <span asp-validation-for="AccountHolderName" class="text-danger small fw-medium mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                                <label class="ios-label">Bank Account Number</label>
                                <div class="input-group ios-input-group">
                                    <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                    <input asp-for="AccountNumber" class="form-control fw-bold" placeholder="Enter Account Number" autocomplete="AccountNumber"/>
                                     <span asp-validation-for="AccountNumber" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="ios-label">IFSC Code</label>
                                <div class="input-group ios-input-group">
                                    <span class="input-group-text"><i class="bi bi-building"></i></span>
                                    <input asp-for="IFSC" class="form-control text-uppercase" placeholder="SBIN0001234" maxlength="11"  />
                                     <span asp-validation-for="IFSC" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="ios-label">Bank Name</label>
                                <div class="input-group ios-input-group">
                                    <span class="input-group-text"><i class="bi bi-bank"></i></span>
                                    <input asp-for="BankName" class="form-control" placeholder="State Bank of India" />
                                    <span asp-validation-for="BankName" class="text-danger small fw-medium mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Info Alert -->
                        <div class="alert ios-alert d-flex align-items-center gap-3 p-3 mb-4" role="alert">
                            <i class="bi bi-shield-lock-fill fs-4"></i>
                            <div style="font-size: 0.85rem; line-height: 1.4;">
                                Your bank details are encrypted and securely registered with <strong class="text-dark">Razorpay Route</strong> for automatic settlements.
                            </div>
                        </div>

                        <!-- iOS Style Submit Button -->
                        <button type="submit" class="btn ios-btn-primary w-100 mt-2">
                            <i class="bi bi-link-45deg fs-5 me-1 align-middle"></i> Connect Bank Account
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>