
@model CanteenX.Models.Admin.EditUserViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Edit User</h2>
            <p class="text-secondary mb-0">
                Update user information, role and account status.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="UserDirectory"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Users
        </a>
    </div>

    <!-- Main Card -->
    <div class="row justify-content-center">
        <div class="col-12 col-xl-9 col-xxl-8">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- Card Header -->
                <div class="card-header bg-white border-bottom p-4">
                    <div class="d-flex align-items-center gap-3">

                        <div class="rounded-3 bg-primary bg-opacity-10
                                    text-primary d-flex align-items-center
                                    justify-content-center"
                             style="width:52px;height:52px;">

                            <i class="bi bi-person-gear fs-3"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                User Information
                            </h5>

                            <p class="text-secondary small mb-0">
                                Make changes to the selected account.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Admin"
                          asp-action="EditUser"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <input asp-for="Id" type="hidden" />

                        <!-- User ID -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                User ID
                            </label>

                            <input asp-for="Id"
                                   class="form-control bg-light"
                                   readonly />

                            <div class="form-text">
                                The user ID cannot be changed.
                            </div>
                        </div>

                        <div class="row g-4">

                            <!-- Full Name -->
                            <div class="col-12 col-md-6">
                                <label asp-for="FullName"
                                       class="form-label fw-semibold">
                                    Full Name
                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter full name"
                                       autocomplete="name" />

                                <span asp-validation-for="FullName"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="name@example.com"
                                       autocomplete="email" />

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Role -->
                            <div class="col-12 col-md-6">
                                <label asp-for="Role"
                                       class="form-label fw-semibold">
                                    System Role
                                </label>

                                <select asp-for="Role"
                                        asp-items="@(ViewBag.Roles as IEnumerable<SelectListItem>)"
                                        class="form-select">
                                    <option value="">
                                        Select a role
                                    </option>
                                </select>

                                <span asp-validation-for="Role"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Account Status -->
                            <div class="col-12 col-md-6">

                                <label class="form-label fw-semibold">
                                    Account Status
                                </label>

                                <div class="border rounded-3 p-3 h-100">
                                    <div class="form-check form-switch">

                                        <input asp-for="IsActive"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               id="IsActive" />

                                        <label asp-for="IsActive"
                                               class="form-check-label fw-semibold"
                                               id="statusLabel">
                                            Active Account
                                        </label>

                                    </div>

                                    <small class="text-secondary d-block mt-2"
                                           id="statusDescription">
                                        This account is active.
                                    </small>
                                </div>
                            </div>

                        </div>

                        <!-- Information Notice -->
                        <div class="alert alert-info border-0 rounded-3 mt-4 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            Review the user's details before saving.
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap justify-content-end
                                    gap-2 mt-4">

                            <a asp-controller="Admin"
                               asp-action="UserDirectory"
                               class="btn btn-light border px-4">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4"
                                    id="saveUserButton">

                                <i class="bi bi-check2-circle me-1"></i>
                                Save Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>

            <p class="text-secondary small text-center mt-3">
                <i class="bi bi-shield-check me-1"></i>
                Changes are submitted securely through the server.
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const statusCheckbox = document.getElementById("IsActive");
            const statusLabel = document.getElementById("statusLabel");
            const statusDescription =
                document.getElementById("statusDescription");

            function updateStatusText() {
                if (statusCheckbox.checked) {
                    statusLabel.textContent = "Active Account";
                    statusDescription.textContent =
                        "This account is active.";
                } else {
                    statusLabel.textContent = "Inactive Account";
                    statusDescription.textContent =
                        "This account is marked as inactive.";
                }
            }

            statusCheckbox.addEventListener("change", updateStatusText);

            updateStatusText();
        });
    </script>
}
