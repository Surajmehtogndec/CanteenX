
@{
    ViewData["Title"] = "View Canteens";
    Layout = "_AdminLayout";
}

<link href="~/css/Admin/CanteenDirectory.css" rel="stylesheet" asp-append-version="true" />
<!-- Background Ambience -->
<div class="bg-blob-1"></div>
<div class="bg-blob-2"></div>

<div class="container-fluid cd-page">
    <div class="cd-card" >

        <!-- UPDATED FLEXBOX TOPBAR -->
        <div class="cd-topbar d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

            <!-- Left Side: Title & Subtitle -->
            <div class="mb-3 mb-md-0">
                <h2 class="cd-title mb-1">Canteen Directory</h2>
                <p class="cd-subtitle mb-0">Manage campus canteens and their visibility.</p>
            </div>

            <!-- Right Side: Search, Filter, and Button -->
            <div class="cd-tools d-flex flex-column flex-md-row gap-3 align-items-md-center">

                <div class="cd-search">
                    <i class="bi bi-search"></i>
                    <input type="search" id="cdSearch" placeholder="Search canteens..." aria-label="Search canteens"  autocomplete="off" maxlength="100" />
                </div>

                <select id="cdStatusFilter" class="form-select cd-select" style="min-width: 150px;">
                    <option value="">All Status</option>
                    <option>Active</option>
                    <option>Inactive</option>
                </select>

                <!-- Add New Canteen Button Link -->
                <a asp-controller="Admin" asp-action="AddCanteens" class="btn-add-canteen text-nowrap">
                    <i class="bi bi-plus-lg"></i> New Canteen
                </a>

            </div>

        </div>

        <div class="cdError"
            class="alert alert-danger mx-3 mt-3 d-none"
             role="alert">
       <i class="bi bi-exclamation-triangle-fill me-2"></i>
       <span id="cdErrorMessage">Unable to load Canteens.</span>
        <button type="button"
                    id="cdRetry"
                    class="btn btn-sm btn-outline-danger ms-2">
                Retry
            </button>
        </div>

        <div class="cd-table-wrap">
            <table class="cd-table" id="cdTable">
                <thead>
                    <tr>
                         <th style="width:50px">
                            <input type="checkbox"
                                   class="cd-check"
                                   id="cdSelectAll"
                                   aria-label="Select Canteens on this page" />
                        </th>

                        <th>Canteen Details</th>
                        <th>Description</th>
                        <th>App Status</th>
                        <th>Added On</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="cdTableBody">
                     <tr>
                        <td colspan="7" class="text-center py-5">
                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status"
                                  aria-hidden="true"></span>
                            Loading Canteens...
                        </td>

                    </tr>
                </tbody>
            </table>
            <div class="cd-empty d-none" id="cdEmpty">
                <i class="bi bi-shop-window fs-1 d-block mb-3"></i>
                <strong class="fs-5 text-dark">No canteens found</strong>
                <div class="mt-1">Try a different search query or filter.</div>
            </div>
        </div>

        <div class="cd-footer">
            <span id="cdResultText" class="text-muted fw-medium" aria-live="polite" >
                Loading Canteens...</span>


                <div  class="d-flex align-items-center gap-3 flex-wrap">
                    <div  class="d-flex align-items-center gap-2">
                        <label for="cdPageSize" class="small text-muted mb-0 fw-bold">
                        Rows
               </label>
                <select id="cdPageSize"
                            class="cd-select"
                            style="min-width:75px;min-height:38px;padding:4px 12px">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="15">15</option>
                        
              </select>
                    </div>
                    <nav id="cdPagination"
                     class="cd-pagination"
                     aria-label="Canteens directory pagination">
                </nav>
                </div>
        </div>
    </div>
</div>
<!-- NAYA: iOS Style Canteen Profile Modal -->
<div class="modal fade" id="cdCanteenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px);">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="cdModalTitle">Canteen Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pb-4" id="cdModalBody">
                <div class="modal-footer">
                 <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                  Close
                 </button>
        </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
       window.canteenDirectoryConfig = {
            endpoint: '@Url.Action("GetCanteenDirectory", "Admin")',
            editUrl: '@Url.Action("EditCanteen", "Admin")'
        };

        
    </script>
     <script src="~/js/canteendirectoryscript.js" asp-append-version="true"></script>
}