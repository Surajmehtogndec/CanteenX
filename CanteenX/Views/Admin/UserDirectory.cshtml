@{
    ViewData["Title"] = "View Users";
    Layout = "_AdminLayout";
}

<link href="~/adminassets/css/UserDirectory.css" rel="stylesheet" asp-append-version="true" />
<!-- Background Ambience -->
<div class="bg-blob-1" aria-hidden="true"></div>
<div class="bg-blob-2" aria-hidden="true"></div>

<div class="container-fluid ud-page">
    <section class="ud-card" aria-labelledby="udPageTitle">
        
         <!-- Header and filters -->
        <div class="ud-topbar">
            <div>
                <h2 class="ud-title" id="udPageTitle">User Directory</h2>
                <p class="ud-subtitle">Manage system access and roles.</p>
            </div>

            <div class="ud-tools">
                 <!-- Search start -->
                <div class="ud-search" aria-hidden="true">
                    <i class="bi bi-search"></i>
                    <input type="search" id="udSearch" placeholder="Search by name, email..."  aria-label="Search users" autocomplete="off"  maxlength="100"/>
                </div>
                  <!-- Search end -->

                  <!-- Filters start -->
                <select id="udStatusFilter" class="ud-select" aria-label="Filter by status">
                    <option value="">All Status</option>
                    <option>Active</option>
                    <option>Inactive</option>
                  
                </select>
                <select id="udRoleFilter" class="ud-select" aria-label="Filter by role">
                    <option value="">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="Student">Student</option>
                    <option value="CanteenStaff">Canteen Staff</option>
                </select>

                <button type="button" class="ud-btn-export" id="udExport">
                   <i class="bi bi-arrow-down-circle me-2" aria-hidden="true">
                   </i>
                Export</button>
            </div>
        </div>

          <!-- Bulk actions -->
        <div class="ud-bulkbar" id="udBulkbar" hidden>
            <span>
              <strong id="udSelectedCount">0</strong> users selected
              <span class="small ms-1">(current page)</span>
           </span>


            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm"
                id="udExportSelected">
                <i class="bi bi-download me-1"></i>Export selected
            </button>
        </div>

        <!-- Loading / error feedback -->
        <div id="udError"
             class="alert alert-danger mx-3 mt-3 d-none"
             role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span id="udErrorMessage">Unable to load users.</span>
            <button type="button"
                    id="udRetry"
                    class="btn btn-sm btn-outline-danger ms-2">
                Retry
            </button>
        </div>

     <!-- User Table-->
    <div class="ud-table-wrap">
       <table class="ud-table" id="udTable">
            <thead>
                <tr>
                        <th style="width:50px">
                            <input type="checkbox"
                                   class="ud-check"
                                   id="udSelectAll"
                                   aria-label="Select users on this page" />
                        </th>
                        <th>User</th>
                        <th>Contact Email</th>
                        <th>System Role</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                  </tr>
            </thead>
             <tbody id="udTableBody">
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <span class="spinner-border spinner-border-sm me-2"
                                  role="status"
                                  aria-hidden="true"></span>
                            Loading users...
                        </td>
                    </tr>
                </tbody>

       </table>
         <div class="ud-empty d-none" id="udEmpty">
                <i class="bi bi-search fs-1 d-block mb-3" aria-hidden="true"></i>
                <strong class="fs-5 text-dark">No records found</strong>
                <div class="mt-1">Try a different search or filter.</div>
            </div>
    </div>


        <div class="ud-footer">
           <span id="udResultText"
                  class="text-muted fw-medium"
                  aria-live="polite">
                Loading users...
            </span>

        <div class="d-flex align-items-center gap-3 flex-wrap">
         <div class="d-flex align-items-center gap-2">
               <label for="udPageSize" class="small text-muted mb-0 fw-bold">
                        Rows
               </label>
               <select id="udPageSize"
                            class="ud-select"
                            style="min-width:75px;min-height:38px;padding:4px 12px">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="15">15</option>
                        
              </select>   
        </div>
            <nav id="udPagination"
                     class="ud-pagination"
                     aria-label="User directory pagination">
                </nav>
  
        </div>

        </div>
        </section>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="udUserModal" tabindex="-1" aria-hidden="true" aria-labelledby="udModalTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
        <div class="modal-header">
            <h5 class="modal-title fs-5 fw-bold" id="udModalTitle"> User Profile</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
      </button>
     </div>
        <div class="modal-body" id="udModalBody"></div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
             Close
          </button>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script>
        window.userDirectoryConfig = {
            endpoint: '@Url.Action("GetUserDirectory", "Admin")'
        };

        console.log(
            "Configured User Directory endpoint:",
            window.userDirectoryConfig.endpoint
        );
    </script>
    <script src="~/adminassets/js/userdirectoryscript.js" asp-append-version="true"></script>

}