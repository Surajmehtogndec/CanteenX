@{
    ViewData["Title"] = "My Cart";
}

<style>
    /* Premium Cart UI Styles */
    body { background-color: #f8f9fa; }
    
    .cart-item-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 16px;
        border: 1px solid rgba(0,0,0,0.03);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .qty-control {
        display: flex;
        align-items: center;
        background: #fdfdfd;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        overflow: hidden;
    }

    .qty-btn {
        background: none;
        border: none;
        padding: 4px 12px;
        color: #ff3b30;
        font-weight: bold;
        font-size: 1.1rem;
        cursor: pointer;
        transition: background 0.2s;
    }
    
    .qty-btn:hover { background: rgba(255, 59, 48, 0.1); }
    
    .qty-input {
        width: 35px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .bill-summary-card {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid rgba(0,0,0,0.03);
        box-shadow: 0 8px 25px rgba(0,0,0,0.04);
        position: sticky;
        top: 20px;
    }

    .checkout-btn {
        background: #ff3b30;
        color: white;
        border-radius: 12px;
        padding: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: transform 0.2s;
    }
    
    .checkout-btn:hover {
        transform: translateY(-2px);
        color: white;
        box-shadow: 0 8px 20px rgba(255, 59, 48, 0.3);
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex align-items-center mb-4">
        <a href="javascript:history.back()" class="text-dark me-3 fs-4"><i class="bi bi-arrow-left"></i></a>
        <h3 class="fw-bold mb-0">My Cart</h3>
    </div>

    <!-- Empty Cart Section (Hidden by default) -->
    <div id="emptyCartSection" class="text-center py-5 d-none">
        <img src="https://cdn-icons-png.flaticon.com/512/11329/11329060.png" alt="Empty Cart" style="width: 150px; opacity: 0.7; margin-bottom: 20px;">
        <h4 class="fw-bold text-dark">Your cart is empty</h4>
        <p class="text-muted mb-4">Looks like you haven't added anything to your cart yet.</p>
        <a href="/Home/Menus" class="btn btn-outline-danger px-4 py-2 rounded-pill fw-bold">Browse Menu</a>
    </div>

    <!-- Cart Items & Bill Summary Section -->
    <div id="cartContentSection" class="row g-4 d-none">
        
        <!-- Items List Column -->
        <div class="col-lg-8" id="cartItemsContainer">
            <!-- JavaScript yahan cards render karega -->
        </div>

        <!-- Bill Summary Column -->
        <div class="col-lg-4">
            <div class="bill-summary-card">
                <h5 class="fw-bold mb-4">Bill Details</h5>
                
                <div class="d-flex justify-content-between mb-3 text-muted">
                    <span>Item Total</span>
                    <span class="fw-medium text-dark" id="itemTotal">₹0</span>
                </div>
                
                
                <hr class="my-3 border-secondary" style="opacity: 0.1;">
                
                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold fs-5 text-dark">To Pay</span>
                    <span class="fw-bold fs-5 text-success" id="grandTotal">₹0</span>
                </div>

                <button class="btn checkout-btn w-100" onclick="proceedToCheckout()">
                    Proceed to Pay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            renderCart();
        });

        function renderCart() {
            let cart = JSON.parse(localStorage.getItem('canteenX_cart')) || [];
            const emptySection = document.getElementById('emptyCartSection');
            const contentSection = document.getElementById('cartContentSection');
            const container = document.getElementById('cartItemsContainer');

            // Agar cart khali hai toh Empty UI dikhao
            if (cart.length === 0) {
                emptySection.classList.remove('d-none');
                contentSection.classList.add('d-none');
                return;
            }

            // Agar items hain, toh Cart UI dikhao
            emptySection.classList.add('d-none');
            contentSection.classList.remove('d-none');
            
            container.innerHTML = '';
            let totalAmount = 0;

            cart.forEach((item, index) => {
                let itemCost = item.price * item.quantity;
                totalAmount += itemCost;

                let cardHtml = `
                    <div class="cart-item-card">
                        <div>
                            <h6 class="fw-bold mb-1" style="font-size: 1.05rem;">${item.name}</h6>
                            <small class="text-muted d-block mb-2"><i class="bi bi-shop me-1"></i>${item.canteen}</small>
                            <span class="fw-bold text-dark fs-6">₹${item.price}</span>
                        </div>
                        
                        <div class="d-flex flex-column align-items-end">
                            <div class="qty-control mb-2">
                                <button class="qty-btn" onclick="updateQuantity('${item.id}', -1)">-</button>
                                <input type="text" class="qty-input" value="${item.quantity}" readonly>
                                <button class="qty-btn" onclick="updateQuantity('${item.id}', 1)">+</button>
                            </div>
                            <span class="text-success fw-bold" style="font-size: 0.9rem;">₹${itemCost}</span>
                        </div>
                    </div>
                `;
                container.innerHTML += cardHtml;
            });

            // Bill Update karo (Platform fee ₹5 jodi hai real feel ke liye)
            document.getElementById('itemTotal').innerText = `₹${totalAmount}`;
            document.getElementById('grandTotal').innerText = `₹${totalAmount}`;
            
            // Global Layout wala UI badge update call
            if(typeof updateCartUI === "function") {
                updateCartUI();
            }
        }

        function updateQuantity(id, change) {
            let cart = JSON.parse(localStorage.getItem('canteenX_cart')) || [];
            let itemIndex = cart.findIndex(i => i.id === id);

            if (itemIndex !== -1) {
                cart[itemIndex].quantity += change;

                // Agar quantity 0 ho jaye, toh item ko delete kar do
                if (cart[itemIndex].quantity <= 0) {
                    cart.splice(itemIndex, 1);
                }

                localStorage.setItem('canteenX_cart', JSON.stringify(cart));
                renderCart(); // UI wapas draw karo
            }
        }

        function proceedToCheckout() {
            // Yahan hum aage chalkar order place karne ka logic (API Call) likhenge
            Swal.fire({
                title: 'Order Ready!',
                text: 'Redirecting to payment/checkout...',
                icon: 'success',
                confirmButtonColor: '#ff3b30'
            });
        }
    </script>
}