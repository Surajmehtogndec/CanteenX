@model CanteenX.Models.Auth.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    /* =========================================
       iOS FROSTED GLASS FORGOT PASSWORD STYLING
       ========================================= */
    body {
        background: radial-gradient(circle at top right, #f8fafc, #edf2f7);
        min-height: 100vh;
    }

    .ios-forgot-wrapper {
        animation: iosFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        position: relative;
        z-index: 1;
    }

    @@keyframes iosFadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Ambient Background Blob */
    .bg-blob {
        position: fixed;
        width: 400px;
        height: 400px;
        background: rgba(232, 40, 26, 0.08);
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        filter: blur(80px);
        z-index: 0;
        animation: pulseBlobCentered 8s infinite alternate ease-in-out;
    }

    @@keyframes pulseBlobCentered {
        0% { transform: translate(-50%, -50%) scale(1); }
        100% { transform: translate(-50%, -50%) scale(1.2); }
    }

    /* iOS Glassmorphism Card Container */
    .ios-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12), 0 10px 20px rgba(0, 0, 0, 0.05);
        border-radius: 28px !important;
        overflow: hidden;
    }

    /* iOS Style Interactive Input Group */
    .ios-input-group {
        background: rgba(240, 243, 246, 0.8);
        border: 1.5px solid rgba(0, 0, 0, 0.06);
        border-radius: 14px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        overflow: hidden;
    }

    .ios-input-group:focus-within {
        background: #ffffff;
        border-color: #e8281a;
        box-shadow: 0 0 0 4px rgba(232, 40, 26, 0.12);
        transform: translateY(-1px);
    }

    .ios-input-group .input-group-text {
        background: transparent;
        border: none;
        color: #8e8e93;
        transition: color 0.3s ease;
    }

    .ios-input-group:focus-within .input-group-text {
        color: #e8281a;
    }

    .ios-input-group .form-control {
        background: transparent;
        border: none;
        padding: 13px 12px;
        box-shadow: none !important;
        font-size: 0.95rem;
        color: #1c1c1e;
        width: 100%;
    }
    .input-invalid{
        border-color: #ff3b30 !important;
        background: rgba(255, 59, 48, 0.03) !important;
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.12) !important;
        animation: iosShake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}
      @@keyframes iosShake {
        10%, 90% { transform: translateX(-2px); }
        20%, 80% { transform: translateX(4px); }
        30%, 50%, 70% { transform: translateX(-6px); }
        40%, 60% { transform: translateX(6px); }
    }

    /* iOS Spring Physics Buttons */
    .ios-primary-btn {
        background: #e8281a;
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 10px 25px rgba(232, 40, 26, 0.3);
    }

    .ios-primary-btn:hover {
        background: #d02013;
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 15px 30px rgba(232, 40, 26, 0.4);
        color: white;
    }

    .ios-primary-btn:active {
        transform: scale(0.97);
    }

    /* Lock Icon Container */
    .icon-circle {
        width: 70px;
        height: 70px;
        background: rgba(232, 40, 26, 0.1);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #e8281a;
        box-shadow: inset 0 0 20px rgba(232, 40, 26, 0.05);
    }

    /* Back to login link */
    .back-link {
        color: #e8281a;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .back-link:hover {
        color: #d02013;
        transform: translateX(-4px);
    }

    @@media (max-width: 768px) {
        .ios-forgot-wrapper {
            margin-top: 2rem !important;
            padding-bottom: 100px;
        }
        .ios-glass-card {
            border-radius: 20px !important;
        }
        .card-body {
            padding: 2rem 1.5rem !important;
        }
    }
</style>

<!-- Ambient Background -->
<div class="bg-blob"></div>

<div class="container py-5 ios-forgot-wrapper">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card ios-glass-card border-0">
                <div class="card-body p-4 p-md-5">

                    <!-- Icon -->
                    <div class="text-center mb-4">
                        <div class="icon-circle">
                            <i class="fas fa-lock fs-2"></i>
                        </div>
                    </div>

                    <!-- Heading -->
                    <div class="text-center mb-4">
                        <h3 class="fw-bold mb-2 text-dark" style="font-family: 'Playfair Display', serif;">
                            Forgot Password?
                        </h3>
                        <p class="text-muted small mb-0" style="line-height: 1.6;">
                            Enter your email address and we'll send you a secure link to reset your password.
                        </p>
                    </div>

                    <!-- Form -->
                    <form asp-controller="Account" asp-action="ForgotPassword" id="forgotForm">
                        @Html.AntiForgeryToken()

                        <!-- Email -->
                        <div class="mb-4">
                            <label for="Email" class="form-label fw-semibold small text-secondary">
                                Email Address
                            </label>
                            <div class="ios-input-group">
                                <span class="input-group-text px-3">
                                    <i class="far fa-envelope"></i>
                                </span>
                                <input type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control"
                                       placeholder="Enter your registered email"
                                       autocomplete="Email"
                                       />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Button -->
                        <button type="submit" class="ios-primary-btn w-100 py-3 mb-4 fs-6" id="forgotBtn">
                            Send Reset Link
                        </button>

                    </form>

                    <!-- Back to Login -->
                    <div class="text-center mt-2">
                        <a asp-controller="Account" asp-action="Login" class="back-link fw-semibold small">
                            <i class="fas fa-arrow-left"></i>
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            
            // 1. SECURE SERVER RESPONSES (XSS Protected)
            @if (ViewBag.SuccessMessage != null)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Email Sent!',
                    text: @Html.Raw(Json.Serialize(ViewBag.SuccessMessage)),
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true,
                     background: 'rgba(255, 255, 255, 0.95)',
                    customClass: { popup: 'rounded-4 shadow-lg border' }
                });
                </text>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <text>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: @Html.Raw(Json.Serialize(ViewBag.ErrorMessage)),
                    showConfirmButton: false,
                    timer: 4000,
                    timerProgressBar: true,
                    background: 'rgba(255, 255, 255, 0.95)',
                    customClass: { popup: 'rounded-4 shadow-lg border' }
                });
                </text>
            }

            // 2. DOM ELEMENTS NULL CHECK (Prevents console errors)
            const form = document.getElementById('forgotForm');
            const emailInput = document.getElementById('Email');
            const submitBtn = document.getElementById('forgotBtn');

            if (!form || !emailInput || !submitBtn) return;

            // 3. CLIENT-SIDE VALIDATION & SHAKE ANIMATION
            const showFieldError = (inputElement, message) => {
                const wrapper = inputElement.closest('.ios-input-group') || inputElement;
                wrapper.classList.remove('input-invalid');
                void wrapper.offsetWidth; // Force reflow to restart animation
                wrapper.classList.add('input-invalid');

                const errorSpan = inputElement.closest('.mb-4')?.querySelector('span.text-danger');
                if (errorSpan) errorSpan.textContent = message;
            };

            const clearFieldError = (inputElement) => {
                const wrapper = inputElement.closest('.ios-input-group') || inputElement;
                wrapper.classList.remove('input-invalid');
                
                const errorSpan = inputElement.closest('.mb-4')?.querySelector('span.text-danger');
                if (errorSpan) errorSpan.textContent = '';
            };

            // Clear red warnings instantly as the user types
            emailInput.addEventListener('input', () => clearFieldError(emailInput));

            form.addEventListener('submit', function (e) {
                let isValid = true;
                const emailValue = emailInput.value.trim();

                // Advanced Email Validation (Empty or Incorrect Format)
                if (!emailValue) {
                    showFieldError(emailInput, 'Email Address is required.');
                    isValid = false;
                }  else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailValue)) {
                    showFieldError(emailInput, 'Please enter a valid email format.');
                    isValid = false;
                }

                // Stop submission, trigger shake and warning toast
                if (!isValid) {
                    e.preventDefault(); 

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: 'Please provide a valid email address!',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        background: 'rgba(255, 255, 255, 0.95)',
                        customClass: {
                            popup: 'rounded-4 shadow-lg border'
                        }
                    });

                    return false;
                }

                // Prevent double submissions and show loading spinner
                submitBtn.style.pointerEvents = 'none';
                submitBtn.style.opacity = '0.85';
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...';
            });
        });
    </script>
}