@model CanteenX.Models.Auth.ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
}

<style>
    /* =========================================
           iOS FROSTED GLASS RESET PASSWORD STYLING
           ========================================= */
    body {
        background: radial-gradient(circle at top right, #f8fafc, #edf2f7);
        min-height: 100vh;
    }

    .ios-reset-wrapper {
        animation: iosFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        position: relative;
        z-index: 1;
    }

    @@keyframes iosFadeUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Ambient Background Blob */
    .bg-blob {
        position: fixed;
        width: 400px;
        height: 400px;
        background: rgba(232, 40, 26, 0.08);
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        filter: blur(80px);
        z-index: 0;
        animation: pulseBlobCentered 8s infinite alternate ease-in-out;
    }

    @@keyframes pulseBlobCentered {
        0% {
            transform: translate(-50%, -50%) scale(1);
        }

        100% {
            transform: translate(-50%, -50%) scale(1.2);
        }
    }

    /* iOS Glassmorphism Card */
    .ios-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(25px) saturate(180%);
        -webkit-backdrop-filter: blur(25px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12), 0 10px 20px rgba(0, 0, 0, 0.05);
        border-radius: 28px !important;
        overflow: hidden;
    }

    /* iOS Style Interactive Input Group */
    .ios-input-group {
        background: rgba(240, 243, 246, 0.8);
        border: 1.5px solid rgba(0, 0, 0, 0.06);
        border-radius: 14px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        overflow: hidden;
    }

        .ios-input-group:focus-within {
            background: #ffffff;
            border-color: #e8281a;
            box-shadow: 0 0 0 4px rgba(232, 40, 26, 0.12);
            transform: translateY(-1px);
        }

        .ios-input-group .input-group-text,
        .ios-input-group .btn {
            background: transparent;
            border: none;
            color: #8e8e93;
            transition: color 0.3s ease;
        }

        .ios-input-group:focus-within .input-group-text {
            color: #e8281a;
        }

        .ios-input-group .form-control {
            background: transparent;
            border: none;
            padding: 13px 12px;
            box-shadow: none !important;
            font-size: 0.95rem;
            color: #1c1c1e;
            width: 100%;
        }

    .input-invalid {
        border-color: #ff3b30 !important;
        background: rgba(255, 59, 48, 0.03) !important;
        box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.12) !important;
        animation: iosShake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    @@keyframes iosShake {
        10%, 90% {
            transform: translateX(-2px);
        }

        20%, 80% {
            transform: translateX(4px);
        }

        30%, 50%, 70% {
            transform: translateX(-6px);
        }

        40%, 60% {
            transform: translateX(6px);
        }
    }

    /* iOS Spring Physics Button */
    .ios-primary-btn {
        background: #e8281a;
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 600;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 10px 25px rgba(232, 40, 26, 0.3);
    }

        .ios-primary-btn:hover {
            background: #d02013;
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 15px 30px rgba(232, 40, 26, 0.4);
            color: white;
        }

        .ios-primary-btn:active {
            transform: scale(0.97);
        }

    /* Icon Container */
    .icon-circle {
        width: 70px;
        height: 70px;
        background: rgba(232, 40, 26, 0.1);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #e8281a;
        box-shadow: inset 0 0 20px rgba(232, 40, 26, 0.05);
    }

    /* Back Link */
    .back-link {
        color: #e8281a;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .back-link:hover {
            color: #d02013;
            transform: translateX(-4px);
        }

    /* Hide default browser password reveal/auto-fill icons */
    input::-ms-reveal,
    input::-ms-clear {
        display: none !important;
    }

    input::-webkit-credentials-auto-fill-button {
        visibility: hidden;
        display: none !important;
    }

    /* Mobile Specific */
    @@media (max-width: 768px) {
        .ios-reset-wrapper {
            margin-top: 1.5rem !important;
            padding-bottom: 100px;
        }

        .ios-glass-card {
            border-radius: 20px !important;
        }

        .card-body {
            padding: 2rem 1.5rem !important;
        }
    }
</style>

<!-- Ambient Background -->
<div class="bg-blob"></div>

<div class="container py-5 ios-reset-wrapper">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card ios-glass-card border-0">
                <div class="card-body p-4 p-md-5">

                    <!-- Icon & Header -->
                    <div class="text-center mb-4">
                        <div class="icon-circle mb-3">
                            <i class="fas fa-shield-alt fs-2"></i>
                        </div>
                        <h3 class="fw-bold mb-2 text-dark" style="font-family: 'Playfair Display', serif;">
                            Reset Password
                        </h3>
                        <p class="text-muted small mb-0" style="line-height: 1.6;">
                            Create a new, strong password for your CanteenX account.
                        </p>
                    </div>

                    <!-- Reset Password Form -->
                    <form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetForm">
                        @Html.AntiForgeryToken()

                        <!-- Hidden Fields -->
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <!-- New Password (Removed inline validation spans) -->
                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-semibold small text-secondary">New Password</label>
                            <div class="ios-input-group">
                                <span class="input-group-text px-3">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input type="password" asp-for="NewPassword" class="form-control" placeholder="Enter new password" autocomplete="new-password" id="newPasswordInput" />
                                <button class="btn px-3" type="button" tabindex="-1" onclick="let inp=this.previousElementSibling; let icon=this.children[0]; if(inp.type==='password'){inp.type='text'; icon.className='far fa-eye-slash text-danger';} else {inp.type='password'; icon.className='far fa-eye';}">
                                    <i class="far fa-eye" id="newPasswordIcon"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Confirm Password (Removed inline validation spans) -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary">Confirm Password</label>
                            <div class="ios-input-group">
                                <span class="input-group-text px-3">
                                    <i class="fas fa-check-circle"></i>
                                </span>
                                <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" autocomplete="new-password" id="confirmPasswordInput" />
                                <button class="btn px-3" type="button" tabindex="-1" onclick="let inp=this.previousElementSibling; let icon=this.children[0]; if(inp.type==='password'){inp.type='text'; icon.className='far fa-eye-slash text-danger';} else {inp.type='password'; icon.className='far fa-eye';}">
                                    <i class="far fa-eye" id="confirmPasswordIcon"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Reset Button -->
                        <button type="submit" class="ios-primary-btn w-100 py-3 mb-4 fs-6 d-flex align-items-center justify-content-center gap-2" id="resetBtn">
                            <span id="resetBtnText">Reset Password</span>
                            <i class="fas fa-arrow-right small" id="resetBtnIcon"></i>
                        </button>
                    </form>

                    <!-- Back to Login -->
                    <div class="text-center mt-2">
                        <a asp-controller="Account" asp-action="Login" class="back-link fw-semibold small">
                            <i class="fas fa-arrow-left"></i>
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // 1. BACKEND ERRORS & MESSAGES
            @if (ViewBag.SuccessMessage != null)
            {
                    <text>
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Password Reset!',
                            text: @Html.Raw(Json.Serialize(ViewBag.SuccessMessage)),
                            showConfirmButton: false,
                            timer: 4000,
                            timerProgressBar: true,
                            background: 'rgba(255, 255, 255, 0.95)',
                            customClass: { popup: 'rounded-4 shadow-lg border' }
                        });
                    </text>
            }

            @if (ViewBag.ErrorMessage != null || TempData["ErrorMessage"] != null)
            {
                    var errorMsg = ViewBag.ErrorMessage ?? TempData["ErrorMessage"];
                    <text>
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'error',
                            title: 'Reset Failed',
                            text: @Html.Raw(Json.Serialize(errorMsg)),
                            showConfirmButton: false,
                            timer: 4000,
                            timerProgressBar: true,
                            background: 'rgba(255, 255, 255, 0.95)',
                            customClass: { popup: 'rounded-4 shadow-lg border' }
                        });
                    </text>
            }

            // Backend ASP.NET Validation Errors
            @if (!ViewData.ModelState.IsValid)
            {
                    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
                    var combinedErrors = string.Join(" | ", errors);
                    <text>
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'error',
                            title: 'Validation Error',
                            text: @Html.Raw(Json.Serialize(combinedErrors)),
                            showConfirmButton: false,
                            timer: 5000,
                            timerProgressBar: true,
                            background: 'rgba(255, 255, 255, 0.95)',
                            customClass: { popup: 'rounded-4 shadow-lg border' }
                        });
                    </text>
            }

            // 2. DOM ELEMENTS NULL CHECK
            const form = document.getElementById('resetForm');
            const newPasswordInput = document.getElementById('newPasswordInput');
            const confirmPasswordInput = document.getElementById('confirmPasswordInput');
            const submitBtn = document.getElementById('resetBtn');

            if (!form || !newPasswordInput || !confirmPasswordInput || !submitBtn) return;

            // 3. PASSWORD VISIBILITY TOGGLE
            document.querySelectorAll('.toggle-pwd-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const wrapper = this.closest('.ios-input-group');
                    const input = wrapper.querySelector('input');
                    const icon = this.querySelector('i');

                    if (input && icon) {
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.className = 'far fa-eye-slash text-danger';
                        } else {
                            input.type = 'password';
                            icon.className = 'far fa-eye';
                        }
                    }
                });
            });

            // 4. LIVE CLIENT-SIDE VALIDATION & SHAKE ANIMATION
            const showFieldError = (inputElement) => {
                const wrapper = inputElement.closest('.ios-input-group') || inputElement;
                wrapper.classList.remove('input-invalid');
                void wrapper.offsetWidth; // Force reflow
                wrapper.classList.add('input-invalid');
            };

            const clearFieldError = (inputElement) => {
                const wrapper = inputElement.closest('.ios-input-group') || inputElement;
                wrapper.classList.remove('input-invalid');
            };

            // Clear errors as user types
            [newPasswordInput, confirmPasswordInput].forEach(el => {
                el.addEventListener('input', () => clearFieldError(el));
            });

            // 5. VALIDATE ON SUBMIT (No Page Refresh)
            form.addEventListener('submit', function (e) {
                let isValid = true;
                let toastErrorMessage = '';

                // Password Regex Pattern: Min 8 chars, 1 Uppercase, 1 Lowercase, 1 Number, 1 Special Char
                const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;

                // Value lete waqt trim na karein (kuch log password mein space rakhte hain)
                const newPwd = newPasswordInput.value;
                const confirmPwd = confirmPasswordInput.value;

                if (!newPwd) {
                    showFieldError(newPasswordInput);
                    toastErrorMessage = 'New Password is required.';
                    isValid = false;
                }
                // Format check using Regex
                else if (!passwordPattern.test(newPwd)) {
                    showFieldError(newPasswordInput);
                    toastErrorMessage = 'Password must be 8+ characters long, with at least 1 uppercase, 1 lowercase, 1 number, and 1 special character.';
                    isValid = false;
                }
                else if (!confirmPwd) {
                    showFieldError(confirmPasswordInput);
                    toastErrorMessage = 'Please confirm your new password.';
                    isValid = false;
                }
                // Match check
                else if (newPwd !== confirmPwd) {
                    showFieldError(newPasswordInput);
                    showFieldError(confirmPasswordInput); // Shake both
                    toastErrorMessage = 'Passwords do not match!';
                    isValid = false;
                }

                // Agar validation fail hui, toh Page Refresh rokein aur Popup dikhayein
                if (!isValid) {
                    e.preventDefault(); // <--- YAHI FUNCTION PAGE REFRESH HONE SE ROKTA HAI

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: 'Validation Failed',
                        text: toastErrorMessage, // Display specific error format or match error
                        showConfirmButton: false,
                        timer: 4500,
                        timerProgressBar: true,
                        background: 'rgba(255, 255, 255, 0.95)',
                        customClass: { popup: 'rounded-4 shadow-lg border' }
                    });
                    return false;
                }

                // Show spinner only if all local validations pass and form is actually submitting
                submitBtn.style.pointerEvents = 'none';
                submitBtn.style.opacity = '0.85';
                document.getElementById('resetBtnText').textContent = 'Processing...';
                document.getElementById('resetBtnIcon').className = 'spinner-border spinner-border-sm';
            });
        });
    </script>
}