@model CanteenX.Models.Auth.LoginDto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
   ViewData["Title"] = "Login ";
}



<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-lg overflow-hidden rounded-4">
                <div class="row g-0">

                    <!-- Left Side: Brand Panel -->
                    <div class="col-md-5 text-white d-none d-md-flex flex-column justify-content-between p-5" style="background-color:  #087f5b;">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <div class="bg-white text-danger rounded p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="fas fa-utensils fs-5"></i>
                                </div>
                                <h3 class="fw-bold mb-0">Canteen<span class="text-warning">X</span></h3>
                            </div>
                            <small class="text-white-50">Smart Campus Food Platform</small>
                        </div>

                        <div class="mt-5 mb-5">
                            <h1 class="fw-bolder display-6">Eat Better.<br /><span class="text-warning">Skip the Queue.</span></h1>
                            <p class="text-white-50 mt-3 fs-6">Order your favorite meals from campus canteens quickly and easily.</p>
                        </div>

                        <small class="text-white-50">&copy; 2026 CanteenX</small>
                    </div>

                    <!-- Right Side: Login Form -->
                    <div class="col-md-7 p-4 p-md-5 bg-white">
                        <div class="mb-4">
                            <h2 class="fw-bold">Welcome back 👋</h2>
                            <p class="text-muted small">Sign in to continue to your CanteenX account.</p>
                        </div>

                        <form asp-controller="Account" asp-action="Login" method="post">

                            <!-- Email Input -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold small" asp-for="EmailOrPhone">Email or Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="far fa-user"></i></span>
                                    <input asp-for="EmailOrPhone" class="form-control bg-light border-start-0 shadow-none" placeholder="Enter email or phone" required>
                                </div>
                                <span class="text-danger small" asp-validation-for="EmailOrPhone"></span>
                            </div>

                            <!-- Password Input -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold small" asp-for="Password">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-lock"></i></span>

                                    <input asp-for="Password" type="password" class="form-control bg-light border-start-0 shadow-none" placeholder="Enter your password" required>

                                    <button class="btn btn-light border border-start-0 text-muted shadow-none" type="button"
                                            onclick="let inp=this.previousElementSibling; let icon=this.children[0]; if(inp.type==='password'){inp.type='text'; icon.className='far fa-eye-slash';} else {inp.type='password'; icon.className='far fa-eye';}">
                                        <i class="far fa-eye"></i>
                                    </button>
                                </div>
                                <span class="text-danger small" asp-validation-for="Password"></span>
                            </div>

                            <!-- Options -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input shadow-none" type="checkbox" id="RememberMe" style="cursor:pointer;">
                                    <label class="form-check-label text-muted small user-select-none" for="RememberMe" style="cursor:pointer;">Remember me</label>
                                </div>
                                <a href="#" class="text-decoration-none small fw-semibold" style="color: #e8281a;">Forgot password?</a>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn text-white w-100 py-2 mb-3 fw-semibold shadow-sm" style="background-color: #e8281a;">
                                Login
                            </button>

                            <div class="d-flex align-items-center my-4">
                                <hr class="flex-grow-1 text-muted opacity-25">
                                <span class="mx-3 text-muted" style="font-size: 11px;">or continue with</span>
                                <hr class="flex-grow-1 text-muted opacity-25">
                            </div>

                            <!-- Google Login -->
                            <a class="btn btn-outline-secondary w-100 py-2 mb-4 text-dark fw-semibold shadow-sm" asp-controller="Account" asp-action="GoogleLogin">
                                <i class="fab fa-google text-primary me-2"></i> Continue with Google
                            </a>

                           

                            <div class="text-center small text-muted">
                                Don't have an account? <a href="~/Account/Register" class="text-decoration-none fw-bold" style="color: #e8281a;">Create account</a>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Login Error Modal -->
<div class="modal fade"
     id="loginErrorModal"
     tabindex="-1"
     aria-labelledby="loginErrorModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="loginErrorModalLabel">
                    Login Failed
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div class="alert alert-danger mb-0">
                    <i class="bi bi-exclamation-circle me-2"></i>

                    @TempData["LoginError"]
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    OK
                </button>

            </div>

        </div>

    </div>

</div>

@if (TempData["LoginError"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            var modalElement =
                document.getElementById("loginErrorModal");

            var modal =
                new bootstrap.Modal(modalElement);

            modal.show();

        });
    </script>
}
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}